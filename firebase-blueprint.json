{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information and role-based access control.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CLINICAL", "CHW"] },
        "clinic": { "type": "string" },
        "clinicId": { "type": "string" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING"] },
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string" }
      },
      "required": ["username", "name", "role", "clinic", "clinicId", "status", "uid"]
    },
    "Clinic": {
      "title": "Clinic Organization",
      "description": "A unique clinic or hospital organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "ownerUid": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "code", "ownerUid", "status", "createdAt"]
    },
    "Patient": {
      "title": "Patient Record",
      "description": "Patient health record and assignment details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "clinic": { "type": "string" },
        "clinicId": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "sector": { "type": "string" },
        "allergies": { "type": "string" },
        "medications": { "type": "string" },
        "ncdRegNumber": { "type": "string" },
        "bpMeasurement": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Normal", "At Risk", "Critical"] },
        "assignedCHW": { "type": "string" },
        "followUps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "officer": { "type": "string" },
              "notes": { "type": "string" },
              "status": { "type": "string", "enum": ["Completed", "Missed", "Scheduled"] }
            }
          }
        }
      },
      "required": ["name", "age", "gender", "clinic", "clinicId", "department", "phone", "address", "registeredAt", "status"]
    },
    "Post": {
      "title": "Community Post",
      "description": "A post shared in the community section.",
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorUid": { "type": "string" },
        "role": { "type": "string" },
        "initial": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "likes": { "type": "number" },
        "comments": { "type": "number" },
        "media": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["image", "video"] },
            "url": { "type": "string" }
          }
        }
      },
      "required": ["author", "authorUid", "timestamp"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "A notification for a specific user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["INFO", "ALERT", "SUCCESS"] },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "title", "message", "read", "timestamp"]
    },
    "PasswordResetRequest": {
      "title": "Password Reset Request",
      "description": "A request by a user to reset their password, requiring admin approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "clinic": { "type": "string" },
        "clinicId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "requestedAt": { "type": "number" },
        "resolvedAt": { "type": "number" }
      },
      "required": ["id", "email", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by their Firebase Auth UID."
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient records shared across the clinic."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Community posts shared across all users."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User-specific notifications."
    },
    "/clinics/{clinicId}": {
      "schema": "Clinic",
      "description": "Registered clinics in the system."
    },
    "/password_reset_requests/{requestId}": {
      "schema": "PasswordResetRequest",
      "description": "Requests for password resyncing/resetting."
    }
  }
}
