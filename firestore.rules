rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // 0. Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. Helper Primitives
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Auth Data Helper
    function getProfile() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "msanjamahendrix3@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getProfile().role == 'SUPER_ADMIN' || getProfile().clinicId == 'SYSTEM'))
      );
    }
    
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (getProfile().role == 'ADMIN' || getProfile().role == 'SUPER_ADMIN');
    }
    
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.email == "msanjamahendrix3@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getProfile().status == 'APPROVED' || getProfile().role == 'SUPER_ADMIN' || getProfile().clinicId == 'SYSTEM'))
      );
    }

    // ===============================================================
    // 2. Validation Blueprints
    // ===============================================================
    
    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'CLINICAL', 'CHW'] &&
             data.clinicId is string && data.clinicId.size() > 0 &&
             data.status in ['APPROVED', 'PENDING'] &&
             data.uid == request.auth.uid;
    }

    function isValidClinic(data) {
      return data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.code is string && data.code.size() == 6 &&
             data.ownerUid == request.auth.uid &&
             data.status in ['ACTIVE', 'SUSPENDED'];
    }

    // ===============================================================
    // 3. Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Read: Any signed in user can view user profiles (directory, referrals, facility staff)
      allow read: if isSignedIn();
      
      // Create: Registration flow
      allow create: if isSignedIn() && isValidUser(incoming()) && 
                    ((isOwner(userId) && incoming().status == 'PENDING') || isSuperAdmin());
      
      // Update: Self (some fields), Admin (clinic staff), or SuperAdmin
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (isAdmin() && getProfile().clinicId == existing().clinicId) ||
        (isOwner(userId) && incoming().role == existing().role && incoming().status == existing().status)
      );
      
      // Delete: Admins can delete their clinic staff. SuperAdmins delete anyone.
      allow delete: if isSuperAdmin() || (isAdmin() && getProfile().clinicId == existing().clinicId);
    }

    match /clinics/{clinicId} {
      allow read: if true; // Public for registration dropdown
      allow create: if isSignedIn() && isValidClinic(incoming());
      allow update: if isSuperAdmin() || (isAdmin() && existing().ownerUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /patients/{patientId} {
      allow read: if isSuperAdmin() || (isApproved() && (getProfile().clinicId == existing().clinicId || getProfile().clinicId == 'SYSTEM'));
      allow create, update: if isApproved() && (isSuperAdmin() || getProfile().clinicId == incoming().clinicId);
      allow delete: if isSuperAdmin() || (isApproved() && (getProfile().role == 'ADMIN' || getProfile().role == 'CLINICAL') && getProfile().clinicId == existing().clinicId);
    }

    match /posts/{postId} {
      allow read: if isSuperAdmin() || (isApproved() && existing().clinicId == getProfile().clinicId);
      allow create: if isApproved() && incoming().clinicId == getProfile().clinicId;
      allow update: if isSignedIn() && (
        (existing().authorUid == request.auth.uid) || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments']))
      );
      allow delete: if isSuperAdmin() || (existing().authorUid == request.auth.uid) || (isAdmin() && getProfile().clinicId == existing().clinicId);
    }

    match /notifications/{notifId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    match /password_reset_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || (isAdmin() && getProfile().clinicId == existing().clinicId);
    }
    
    match /resource_requests/{requestId} {
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().keys().hasAll(['id', 'userId', 'userName', 'clinicId', 'clinicName', 'topic', 'message', 'status', 'requestedAt']) &&
                    incoming().status == 'PENDING';
      allow read: if isSuperAdmin() || (isAdmin() && getProfile().clinicId == existing().clinicId) || (isSignedIn() && existing().userId == request.auth.uid);
      allow update: if isSuperAdmin() || (isAdmin() && getProfile().clinicId == existing().clinicId);
      allow delete: if isSuperAdmin();
    }
  }
}
